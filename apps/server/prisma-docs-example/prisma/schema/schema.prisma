generator docs {
  provider = "node node_modules/prisma-docs-generator"
  output   = "./docs"
}

generator markdown {
  provider = "prisma-markdown"
  output   = "./ERD.md"
  title    = "학원 관리 시스템 데이터베이스 명세서"
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

